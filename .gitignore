# ============================================================
# STM32CubeIDE / STM32CubeMX
# ============================================================

# Build directories
**/Debug/
**/Release/
**/build/
**/Build/
**/out/

# Eclipse / STM32CubeIDE local settings
**/.settings/
**/.metadata/
**/*.launch
**/.mxproject

# Generated dependency/build files
**/*.o
**/*.obj
**/*.d
**/*.dep
**/*.su
**/*.cyclo

# Firmware binaries
**/*.elf
**/*.bin
**/*.hex
**/*.map
**/*.list
**/*.lst

# Libraries generated during compilation
**/*.a
**/*.lib


# ============================================================
# ROS 2 / colcon
# ============================================================

# Generated by colcon
**/build/
**/install/
**/log/

# Python cache
**/__pycache__/
**/*.py[cod]

# Python package build artifacts
**/*.egg-info/
**/.eggs/

# Testing / coverage
**/.pytest_cache/
**/.coverage
**/htmlcov/

# ROS bag files
**/rosbag2_*/
**/*.db3
**/*.mcap


# ============================================================
# Temporary files
# ============================================================

*.bak
*.tmp
*.orig
*.swp
*.swo
*~


# ============================================================
# Editors
# ============================================================

.vscode/
.idea/


# ============================================================
# Operating systems
# ============================================================

.DS_Store
Thumbs.db
Desktop.ini
.directory
